generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  STAFF
}

enum FoodType {
  Veg
  Non_Veg
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String?
  role          Role           @default(CUSTOMER)
  avatar        String?
  addresses     Address[]
  orders        Order[]
  reservations  Reservation[]
  partyOrders   PartyOrder[]
  reviews       Review[]
  wishlistItems Wishlist[]
  notifications Notification[]
  couponUsages  CouponUsage[]
  employee      Employee?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id               String      @id
  slug             String      @unique
  name             String
  description      String
  categoryId       String?
  category         Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryLabel    String
  cuisine          String
  price            Int
  type             FoodType
  calories         Int
  preparationTime  Int
  image            String
  available        Boolean     @default(true)
  rating           Float       @default(4.5)
  spiceLevel       String
  featured         Boolean     @default(false)
  bestSeller       Boolean     @default(false)
  todaysSpecial    Boolean     @default(false)
  inventoryItems   Inventory[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlistedBy     Wishlist[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Order {
  id               String         @id @default(cuid())
  userId           String
  addressId        String?
  status           OrderStatus    @default(PENDING)
  subtotal         Int
  deliveryCharge   Int
  gst              Int
  discount         Int            @default(0)
  total            Int
  paymentMethod    String
  notes            String?
  address          Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]
  payment          Payment?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  menuItemId  String
  quantity    Int
  price       Int
  total       Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Int
  transactionRef    String?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Reservation {
  id              String             @id @default(cuid())
  userId          String?
  guestName       String
  guestEmail      String
  guestPhone      String
  guestsCount     Int
  reservationDate DateTime
  specialRequests String?
  status          ReservationStatus  @default(PENDING)
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model PartyOrder {
  id              String   @id @default(cuid())
  userId          String?
  eventType       String
  guestCount      Int
  eventDate       DateTime
  budget          Int?
  notes           String?
  status          String   @default("ENQUIRY")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  menuItemId  String?
  rating      Int
  title       String?
  comment     String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Wishlist {
  id          String   @id @default(cuid())
  userId      String
  menuItemId  String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, menuItemId])
}

model Coupon {
  id            String        @id @default(cuid())
  code          String        @unique
  title         String
  description   String?
  discountType  String
  discountValue Int
  minOrderValue Int?
  maxDiscount   Int?
  active        Boolean       @default(true)
  expiresAt     DateTime?
  usages        CouponUsage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  orderId    String?
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  title      String
  message    String
  read       Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Employee {
  id          String   @id @default(cuid())
  userId      String   @unique
  employeeId  String   @unique
  designation String
  shift       String
  salary      Int?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id           String   @id @default(cuid())
  menuItemId   String?
  ingredient   String
  stockUnit    String
  stockLevel   Float
  reorderLevel Float
  supplier     String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Gallery {
  id         String   @id @default(cuid())
  title      String
  image      String
  category   String
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Offer {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  badge       String?
  code        String?
  discount    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
